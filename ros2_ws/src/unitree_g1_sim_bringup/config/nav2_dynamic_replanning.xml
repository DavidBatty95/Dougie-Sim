<!-- Event-driven requests, bounded by the costmap's 5 Hz updates. PipelineSequence
     keeps FollowPath running while a replacement route is computed. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="60" name="DynamicNavigationRecovery">
      <PipelineSequence name="NavigateWithDynamicReplanning">
        <ReactiveFallback name="KeepOrReplaceRoute">
          <Inverter>
            <ReplanRequested path="{path}" goal="{goal}" minimum_interval="0.2" fallback_interval="0.75"/>
          </Inverter>
          <RecoveryNode number_of_retries="1" name="RecomputeRoute">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <Delay delay_msec="200"><AlwaysSuccess/></Delay>
          </RecoveryNode>
        </ReactiveFallback>
        <FollowPath path="{path}" controller_id="FollowPath"/>
      </PipelineSequence>
      <ReactiveFallback>
        <GoalUpdated/>
        <Delay delay_msec="250"><AlwaysSuccess/></Delay>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
