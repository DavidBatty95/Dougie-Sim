+def test_step_foundation_exposes_raw_actions_and_rehearses_prior_skills() -> None:
+  task_id = "Mjlab-Velocity-Flat-StepFoundation-Unitree-G1"
+  cfg = load_env_cfg(task_id)
+  command_cfg = cfg.commands["twist"]
+  action_cfg = cfg.actions["joint_pos"]
+  agent_cfg = load_rl_cfg(task_id)
+  assert isinstance(command_cfg, StandCreepStopVelocityCommandCfg)
+  assert isinstance(action_cfg, JointPositionActionCfg)
+  assert command_cfg.low_speed_probability == 0.55
+  assert command_cfg.moderate_speed_probability == 0.20
+  assert command_cfg.reverse_probability == 0.35
+  assert command_cfg.moving_stop_probability == 0.30
+  assert command_cfg.standing_hold_probability == 0.15
+  assert command_cfg.lateral_probability == 0.0
+  assert command_cfg.yaw_speed_min == 0.08
+  assert command_cfg.yaw_speed_max == 0.18
+  assert action_cfg.clip_to_soft_joint_limits
+  assert cfg.rewards["track_linear_velocity"].weight == 5.0
+  assert cfg.rewards["track_linear_velocity"].params["std"] == 0.12
+  assert cfg.rewards["track_angular_velocity"].weight == 4.0
+  assert cfg.rewards["track_angular_velocity"].params["std"] == 0.20
+  assert cfg.rewards["standing_base_velocity"].weight == -2.0
+  assert cfg.rewards["action_excess_l2"].weight == -5.0
+  assert cfg.rewards["alternating_touchdown"].weight == 0.30
+  assert agent_cfg.clip_actions is None
+  assert agent_cfg.algorithm.learning_rate == 2.0e-5
+  assert agent_cfg.max_iterations == 3_000
+
+
