Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 38; 42; 48
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Known static scene map
      Enabled: true
      Alpha: 0.65
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /simulation/static_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: G1
      Enabled: true
      Alpha: 1
      Collision Enabled: false
      Visual Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Reachable mission waypoint
      Enabled: true
      Color: 80; 255; 80
      Shape: Arrow
      Shaft Length: 0.6
      Shaft Radius: 0.04
      Head Length: 0.2
      Head Radius: 0.1
      Topic:
        Value: /benchmark/current_goal
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Nav2 validated route
      Enabled: true
      Color: 25; 220; 255
      Alpha: 1
      Line Style: Lines
      Line Width: 0.05
      Buffer Length: 1
      Pose Style: None
      Topic:
        Value: /plan
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: People and predictions (ORACLE)
      Enabled: true
      Namespaces:
        dynamic_obstacle_labels: false
        tracked_object_paths: false
        tracked_people: true
        tracked_people_predictions: true
        tracked_people_danger_corridors: true
      Topic:
        Value: /dynamic_obstacles
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Executable avoidance candidates
      Enabled: true
      Namespaces:
        human_aware_candidates: true
        human_aware_state: false
      Topic:
        Value: /human_avoidance_markers
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Mission status (ORACLE)
      Enabled: true
      Topic:
        Value: /benchmark/social_demo_oracle
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 8
      Pitch: 1.05
      Yaw: 0.8
      Focal Point: {X: 0, Y: 0, Z: 0.5}
      Target Frame: base_footprint
      Near Clip Distance: 0.01
    Saved: ~
Window Geometry:
  Width: 1400
  Height: 900
  Hide Left Dock: true
  Hide Right Dock: true
