   return cfg
 
 
+def unitree_g1_step_foundation_ppo_runner_cfg() -> RslRlOnPolicyRunnerCfg:
+  """Expose raw actor output so the action-excess reward can bound the policy."""
+  cfg = unitree_g1_stand_creep_stop_finetune_ppo_runner_cfg()
+  cfg.clip_actions = None
+  cfg.algorithm.learning_rate = 2.0e-5
+  cfg.algorithm.entropy_coef = 0.006
+  cfg.max_iterations = 3_000
+  return cfg
+
+
