+++ b/tools/test_natural_meshes.py
@@ -0,0 +1,25 @@
+import math
+from pathlib import Path
+
+import numpy as np
+
+from generate_natural_pedestrians import MODELS, load_mesh, walking_vertices
+
+
+def test_relaxed_arms_and_forward_leg_swing_from_real_bundled_assets():
+    source = Path(__file__).parents[1] / "unitree_robots/g1/models/pedestrians/walk_frames"
+    for name in MODELS:
+        rest, topology = load_mesh(source / f"{name}_walk_00.obj")
+        idle = walking_vertices(rest, None)
+        assert np.isfinite(idle).all()
+        assert np.ptp(idle[:, 0]) < .80, name
+        assert np.ptp(idle[:, 0]) < np.ptp(rest[:, 0]) * .7, name
+        assert "vn " not in topology
+        forward = walking_vertices(rest, math.pi/2)
+        backward = walking_vertices(rest, 3*math.pi/2)
+        leg = (rest[:, 0] > .04) & (rest[:, 2] < .5)
+        assert np.max(np.abs(forward[leg, 1]-backward[leg, 1])) > .15, name
+        for frame in range(16):
+            points = walking_vertices(rest, 2*math.pi*frame/16)
+            assert points[:, 2].min() >= -1e-5, (name, frame)
+            assert abs(points[:, 2].max()-idle[:, 2].max()) < .01, (name, frame)
