# Close the last gap to a measured object, after navigation has got the robot roughly there.
# Must match a class_id published on /objects.
string object_id
string ARM_LEFT=left
string ARM_RIGHT=right
string arm
# Heading to hold while approaching in the odometry frame, radians.
float64 working_yaw
bool use_current_heading
# Zero uses the server default.
float64 timeout_s
---
bool success
string message
float64 final_x_m
float64 final_y_m
---
string PHASE_LOCATING=locating
string PHASE_CLOSING=closing
string PHASE_VERIFYING=verifying
string phase
float64 forward_error_m
float64 lateral_error_m
