Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane: XY
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: false
      Show Axes: true
      Show Arrows: true
    - Class: rviz_default_plugins/Map
      Name: SLAM Occupancy Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.75
      Color Scheme: map
      Draw Behind: true
    - Class: rviz_default_plugins/LaserScan
      Name: Projected Livox /scan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (Pixels): 3
      Style: Points
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/MarkerArray
      Name: Dynamic Obstacles
      Enabled: true
      Topic:
        Value: /dynamic_obstacles
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: Tracked Object Footprints
      Enabled: true
      Topic:
        Value: /tracked_dynamic_obstacles
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (Pixels): 8
      Color Transformer: FlatColor
      Color: 255; 40; 20
      Decay Time: 0.6
      Queue Size: 3
    - Class: rviz_default_plugins/PointCloud2
      Name: Predicted Object Risk
      Enabled: true
      Topic:
        Value: /predicted_dynamic_obstacles
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (Pixels): 5
      Color Transformer: FlatColor
      Color: 255; 190; 0
      Decay Time: 0.8
      Queue Size: 3
    - Class: rviz_default_plugins/Map
      Name: Human Safety Grid
      Enabled: false
      Topic:
        Value: /human_safety_grid
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Alpha: 0.45
      Color Scheme: costmap
      Draw Behind: false
    - Class: rviz_default_plugins/Pose
      Name: Current Nav2 Goal
      Enabled: true
      Topic:
        Value: /exploration_goal
        Reliability Policy: Reliable
      Shape: Arrow
      Shaft Length: 0.8
      Shaft Radius: 0.05
      Head Length: 0.25
      Head Radius: 0.12
      Color: 255; 80; 20
    - Class: rviz_default_plugins/Marker
      Name: Waypoint Exploration Goal Marker
      Enabled: true
      Topic:
        Value: /exploration_goal_marker
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Queue Size: 10
    - Class: rviz_default_plugins/MarkerArray
      Name: Human-Aware Candidate Trajectories
      Enabled: true
      Topic:
        Value: /human_avoidance_markers
        Reliability Policy: Reliable
      Queue Size: 10
    - Class: rviz_default_plugins/Map
      Name: Human Social Risk Grid
      Enabled: false
      Topic:
        Value: /human_social_risk_grid
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Alpha: 0.45
      Color Scheme: costmap
      Draw Behind: false
    - Class: rviz_default_plugins/Path
      Name: Nav2 Global Path
      Enabled: true
      Topic:
        Value: /plan
        Reliability Policy: Reliable
      Color: 25; 220; 255
      Line Style: Lines
      Line Width: 0.06
    - Class: rviz_default_plugins/Path
      Name: Nav2 Local Plan
      Enabled: true
      Topic:
        Value: /local_plan
        Reliability Policy: Reliable
      Color: 255; 190; 20
      Line Style: Lines
      Line Width: 0.04
    - Class: rviz_default_plugins/RobotModel
      Name: G1 Robot Model
      Enabled: true
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/PointCloud2
      Name: MuJoCo Livox mj_multiRay
      Enabled: true
      Topic:
        Value: /livox/lidar_world
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: Intensity
      Decay Time: 0
      Queue Size: 10
    - Class: rviz_default_plugins/Image
      Name: D435i Color
      Enabled: false
      Normalize Range: true
      Topic:
        Value: /camera/camera/color/image_raw
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Camera
      Name: D435i Camera View
      Enabled: false
      Image Topic:
        Value: /camera/camera/color/image_raw
        Reliability Policy: Best Effort
      Overlay Alpha: 0.6
      Queue Size: 2
    - Class: rviz_default_plugins/Image
      Name: D435i Depth
      Enabled: false
      Max Value: 4000
      Min Value: 0
      Normalize Range: true
      Topic:
        Value: /camera/camera/depth/image_rect_raw
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: D435i Depth Points
      Enabled: false
      Topic:
        Value: /camera/camera/depth/color/points
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
  Enabled: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 0.8
      Name: Current View
      Pitch: 0.45
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
