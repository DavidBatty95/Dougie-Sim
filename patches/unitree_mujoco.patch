diff --git a/simulate/src/brainco_hand.h b/simulate/src/brainco_hand.h
new file mode 100644
index 0000000..8a00955
--- /dev/null
+++ b/simulate/src/brainco_hand.h
@@ -0,0 +1,115 @@
+#pragma once
+#include <mujoco/mujoco.h>
+#include <unitree/idl/go2/MotorCmds_.hpp>
+#include <unitree/idl/go2/MotorStates_.hpp>
+#include <unitree/robot/channel/channel_publisher.hpp>
+#include <unitree/robot/channel/channel_subscriber.hpp>
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <limits>
+#include <memory>
+#include <mutex>
+#include <string>
+
+namespace unitree_mujoco {
+// Revo2 hardware-compatible six-channel transport. Finger forces act on their
+// own DOFs; the existing 29 body actuators/sensor ordering remain unchanged.
+class BraincoHands {
+  using Command = unitree_go::msg::dds_::MotorCmds_;
+  using State = unitree_go::msg::dds_::MotorStates_;
+  struct Hand {
+    std::mutex mutex;
+    std::array<int,6> joint{}, qpos{}, dof{};
+    std::array<double,6> target{}, reference{}, speed{1,1,1,1,1,1};
+    bool enabled = false;
+    std::shared_ptr<unitree::robot::ChannelSubscriber<Command>> subscriber;
+    std::shared_ptr<unitree::robot::ChannelPublisher<State>> publisher;
+  };
+  std::array<Hand,2> hands_;
+  const mjModel *model_ = nullptr;
+  double last_time_ = -1., next_state_ = 0.;
+  const std::array<std::string,6> names_ = {"thumb_proximal", "thumb_metacarpal",
+      "index_proximal", "middle_proximal", "ring_proximal", "pinky_proximal"};
+  const std::array<double,6> speeds_ = {2.5303,2.6175,2.2685,2.2685,2.2685,2.2685};
+
+  void Receive(std::size_t side, const void *message) {
+    const auto &command = *static_cast<const Command *>(message);
+    if (command.cmds().size() != 6) {return;}
+    for (const auto &motor : command.cmds()) {
+      if (!std::isfinite(motor.q()) || !std::isfinite(motor.dq())) {return;}
+    }
+    auto &hand = hands_[side];
+    std::lock_guard<std::mutex> lock(hand.mutex);
+    for (std::size_t i=0; i<6; ++i) {
+      hand.target[i] = std::clamp<double>(command.cmds()[i].q(),0.,1.);
+      hand.speed[i] = std::clamp<double>(command.cmds()[i].dq(),0.,1.);
+    }
+  }
+
+  void Bind(const mjModel *model, const mjData *data) {
+    model_ = model;
+    next_state_ = 0.;
+    for (std::size_t side=0; side<2; ++side) {
+      auto &hand = hands_[side];
+      const std::string prefix = side == 0 ? "left" : "right";
+      hand.enabled = true;
+      for (std::size_t i=0; i<6; ++i) {
+        const int joint = mj_name2id(model,mjOBJ_JOINT,(prefix+"_"+names_[i]+"_joint").c_str());
+        if (joint < 0) {hand.enabled = false; break;}
+        hand.joint[i] = joint;
+        hand.qpos[i] = model->jnt_qposadr[joint];
+        hand.dof[i] = model->jnt_dofadr[joint];
+        hand.reference[i] = data->qpos[hand.qpos[i]];
+      }
+      if (!hand.enabled) {continue;}
+      {
+        std::lock_guard<std::mutex> lock(hand.mutex);
+        hand.target.fill(0.);
+        hand.speed.fill(1.);
+      }
+      if (!hand.publisher) {
+        hand.publisher = std::make_shared<unitree::robot::ChannelPublisher<State>>("rt/brainco/"+prefix+"/state");
+        hand.publisher->InitChannel();
+        hand.subscriber = std::make_shared<unitree::robot::ChannelSubscriber<Command>>("rt/brainco/"+prefix+"/cmd");
+        hand.subscriber->InitChannel([this,side](const void *msg){Receive(side,msg);},1);
+      }
+    }
+  }
+
+ public:
+  void Update(const mjModel *model, mjData *data) {
+    if (model != model_ || data->time < last_time_) {Bind(model,data);}
+    last_time_ = data->time;
+    const bool publish = data->time >= next_state_;
+    if (publish) {next_state_ = data->time+.02;}
+    for (auto &hand : hands_) {
+      if (!hand.enabled) {continue;}
+      std::array<double,6> target, speed;
+      {
+        std::lock_guard<std::mutex> lock(hand.mutex);
+        target = hand.target;
+        speed = hand.speed;
+      }
+      State state;
+      state.states().resize(6);
+      for (std::size_t i=0; i<6; ++i) {
+        const int joint = hand.joint[i];
+        const double lo = model->jnt_range[2*joint], hi = model->jnt_range[2*joint+1];
+        const double desired = lo+target[i]*(hi-lo);
+        const double step = speeds_[i]*speed[i]*model->opt.timestep;
+        hand.reference[i] += std::clamp(desired-hand.reference[i],-step,step);
+        const double q = data->qpos[hand.qpos[i]], dq = data->qvel[hand.dof[i]];
+        // Simulation motor model, not a claimed calibration of hardware current.
+        const double limit = i == 1 ? .08 : .18;
+        data->qfrc_applied[hand.dof[i]] = std::clamp(4.*(hand.reference[i]-q)-.04*dq,-limit,limit);
+        state.states()[i].q() = std::clamp((q-lo)/(hi-lo),0.,1.);
+        state.states()[i].dq() = std::clamp(std::abs(dq)/speeds_[i],0.,1.);
+        // The vendor uses tau_est for amperes. No current sensor is simulated.
+        state.states()[i].tau_est() = std::numeric_limits<float>::quiet_NaN();
+      }
+      if (publish) {hand.publisher->Write(state);}
+    }
+  }
+};
+}
diff --git a/tools/generate_natural_pedestrians.py b/tools/generate_natural_pedestrians.py
new file mode 100644
index 0000000..2b5ab20
--- /dev/null
+++ b/tools/generate_natural_pedestrians.py
@@ -0,0 +1,144 @@
+#!/usr/bin/env python3
+"""Build relaxed-arm walk morphs and data-driven mocap frames from bundled meshes.
+
+All frame geometry is compiled once. Runtime animation changes mjData mocap
+poses, so rendering and raycast workers see the same pose without mjModel edits.
+"""
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+import xml.etree.ElementTree as ET
+
+import numpy as np
+
+FRAMES = 16
+MODELS = ("carla", "eric", "claudia")
+
+
+def smoothstep(values):
+    values = np.clip(values, 0., 1.)
+    return values*values*(3.-2.*values)
+
+
+def rotate_x(points, pivot, angles):
+    result = points.copy()
+    y, z = points[:, 1]-pivot[1], points[:, 2]-pivot[2]
+    result[:, 1] = pivot[1]+np.cos(angles)*y-np.sin(angles)*z
+    result[:, 2] = pivot[2]+np.sin(angles)*y+np.cos(angles)*z
+    return result
+
+
+def walking_vertices(rest, phase):
+    """Procedural skinning of the supplied neutral pose, in metres, facing -Y."""
+    out = rest.copy()
+    height = float(rest[:, 2].max())
+    scale = height/1.75
+    x, z = rest[:, 0], rest[:, 2]
+    side = np.where(x >= 0, 1., -1.)
+    shoulder_z, shoulder_x = .80*height, .19*scale
+    arms = smoothstep((np.abs(x)-.17*scale)/(.14*scale))
+    arm_floor = shoulder_z - 1.5*(np.abs(x)-shoulder_x) - .12*scale
+    arms *= smoothstep((z-arm_floor)/(.12*scale))
+    dx, dz = np.abs(x)-shoulder_x, z-shoulder_z
+    angle = .68*arms
+    out[:, 0] = side*(shoulder_x + np.cos(angle)*dx + np.sin(angle)*dz)
+    out[:, 2] = shoulder_z - np.sin(angle)*dx + np.cos(angle)*dz
+    elbow = smoothstep((np.hypot(dx, dz)-.26*scale)/(.16*scale))*arms
+    bent = rotate_x(out, (0., 0., shoulder_z-.30*scale), -.20*elbow)
+    sine = 0. if phase is None else math.sin(phase)
+    cosine = 0. if phase is None else math.cos(phase)
+    out = rotate_x(bent, (0., 0., shoulder_z), (.22*sine*side)*arms)
+    # Soft leg weights preserve the pelvis/clothes seam; swing is in Y/Z,
+    # not laterally in X. Flex the swing knee and plant the stance foot.
+    legs = 1.-smoothstep((z-.47*height)/(.10*height))
+    leg_side = np.tanh(x/(.035*height))
+    swing = sine*leg_side
+    lower_leg = 1.-smoothstep((z-.24*height)/(.11*height))
+    knees = .52*np.maximum(0., cosine*leg_side)*lower_leg*legs
+    out = rotate_x(out, (0., 0., .28*height), knees)
+    out = rotate_x(out, (0., 0., .52*height), -.30*swing*legs)
+    for sign in (-1., 1.):
+        foot = (side == sign) & (z < .10*height)
+        if not foot.any():
+            continue
+        minimum = float(out[foot, 2].min())
+        if cosine*sign <= 0 or minimum < 0:
+            weights = (side == sign)*legs
+            out[:, 2] -= minimum*weights
+    return out
+
+
+def load_mesh(path):
+    vertices, other = [], []
+    for line in path.read_text().splitlines():
+        if line.startswith("v "):
+            vertices.append([float(v)*.01 for v in line.split()[1:4]])
+        elif line.startswith("vn ") or line.startswith("o "):
+            continue
+        elif line.startswith("f "):
+            # Let MuJoCo recompute normals for the deformed geometry. Keep UVs.
+            other.append("f " + " ".join("/".join(token.split("/")[:2]).rstrip("/") for token in line.split()[1:]))
+        else:
+            other.append(line)
+    return np.asarray(vertices), "\n".join(other) + "\n"
+
+
+def generate(robot_dir):
+    source = robot_dir / "models/pedestrians/walk_frames"
+    output = robot_dir / "models/pedestrians/natural_walk"
+    inputs = [Path(__file__), *(source / f"{name}_walk_00.obj" for name in MODELS)]
+    fingerprint = hashlib.sha256(b"".join(p.read_bytes() for p in inputs)).hexdigest()
+    manifest = output / "manifest.json"
+    assets_file, bodies_file = robot_dir / "natural_crowd_assets.xml", robot_dir / "natural_crowd_bodies.xml"
+    expected = [output / f"{name}_{frame:02d}.obj" for name in MODELS for frame in range(FRAMES+1)]
+    if manifest.exists() and json.loads(manifest.read_text()).get("fingerprint") == fingerprint and all(p.exists() for p in [*expected, assets_file, bodies_file]):
+        print("Natural pedestrian assets are up to date")
+        return
+    output.mkdir(parents=True, exist_ok=True)
+    assets = ET.Element("mujocoinclude")
+    section = ET.SubElement(assets, "asset")
+    for name in MODELS:
+        rest, topology = load_mesh(source / f"{name}_walk_00.obj")
+        for frame in range(FRAMES+1):
+            points = walking_vertices(rest, None if frame == FRAMES else 2.*math.pi*frame/FRAMES)
+            path = output / f"{name}_{frame:02d}.obj"
+            with path.open("w") as stream:
+                stream.write(f"# Generated natural walk; source={name}_walk_00.obj\n")
+                np.savetxt(stream, points*100., fmt="v %.6f %.6f %.6f")
+                stream.write(topology)
+            ET.SubElement(section, "mesh", name=f"ped_{name}_natural_{frame:02d}",
+                file=f"../models/pedestrians/natural_walk/{path.name}", scale="0.01 0.01 0.01")
+    bodies = ET.Element("mujocoinclude")
+    world = ET.SubElement(bodies, "worldbody")
+    for index in range(1, 9):
+        name = MODELS[(index-1) % len(MODELS)]
+        if index > 6:
+            for part, kind, size, span in (
+                ("torso", "capsule", ".16", "0 0 -.32 0 0 .32"),
+                ("head", "sphere", ".12", None),
+                ("left_leg", "capsule", ".055", "0 0 -.34 0 0 .34"),
+                ("right_leg", "capsule", ".055", "0 0 -.34 0 0 .34"),
+                ("left_arm", "capsule", ".045", "0 0 -.25 0 0 .25"),
+                ("right_arm", "capsule", ".045", "0 0 -.25 0 0 .25")):
+                body = ET.SubElement(world, "body", name=f"ped{index}_{part}", mocap="true", pos="0 0 -50")
+                geom = ET.SubElement(body, "geom", type=kind, size=size, material="ped_skin")
+                if span:
+                    geom.set("fromto", span)
+        for frame in range(FRAMES+1):
+            body = ET.SubElement(world, "body", name=f"ped{index}_visual_{frame:02d}", mocap="true", pos="0 0 -50")
+            ET.SubElement(body, "geom", name=f"ped{index}_natural_frame_{frame:02d}", type="mesh",
+                mesh=f"ped_{name}_natural_{frame:02d}", material=f"ped_{name}_skin",
+                pos="0 0 -0.99", contype="0", conaffinity="0", group="1")
+    ET.indent(assets); ET.indent(bodies)
+    ET.ElementTree(assets).write(assets_file, encoding="unicode")
+    ET.ElementTree(bodies).write(bodies_file, encoding="unicode")
+    manifest.write_text(json.dumps({"fingerprint": fingerprint, "frames": FRAMES, "people": 8}, indent=2))
+    print(f"Generated {len(expected)} natural walk meshes and eight animated pedestrians")
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--robot-dir", type=Path, required=True)
+    generate(parser.parse_args().robot_dir)
