<?xml version="1.0"?>
<robot name="unitree_g1_29dof_brainco" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="mesh_dir" value="package://unitree_g1_description/meshes"/>

  <xacro:macro name="mesh_link" params="name mesh:=^">
    <link name="${name}">
      <visual>
        <geometry>
          <mesh filename="${mesh_dir}/${mesh}.STL"/>
        </geometry>
      </visual>
    </link>
  </xacro:macro>

  <xacro:macro name="revolute_joint" params="name parent child xyz rpy axis lower upper">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower}" upper="${upper}" effort="200" velocity="10"/>
    </joint>
  </xacro:macro>

  <link name="base_footprint"/>
  <xacro:mesh_link name="pelvis" mesh="pelvis"/>
  <joint name="floating_base_joint" type="prismatic">
    <parent link="base_footprint"/>
    <child link="pelvis"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.2" upper="1.2" effort="0" velocity="0"/>
  </joint>

  <xacro:mesh_link name="left_hip_pitch_link" mesh="left_hip_pitch_link"/>
  <xacro:mesh_link name="left_hip_roll_link" mesh="left_hip_roll_link"/>
  <xacro:mesh_link name="left_hip_yaw_link" mesh="left_hip_yaw_link"/>
  <xacro:mesh_link name="left_knee_link" mesh="left_knee_link"/>
  <xacro:mesh_link name="left_ankle_pitch_link" mesh="left_ankle_pitch_link"/>
  <xacro:mesh_link name="left_ankle_roll_link" mesh="left_ankle_roll_link"/>

  <xacro:revolute_joint name="left_hip_pitch_joint" parent="pelvis" child="left_hip_pitch_link" xyz="0 0.064452 -0.1027" rpy="0 0 0" axis="0 1 0" lower="-2.5307" upper="2.8798"/>
  <xacro:revolute_joint name="left_hip_roll_joint" parent="left_hip_pitch_link" child="left_hip_roll_link" xyz="0 0.052 -0.030465" rpy="0 -0.17490010 0" axis="1 0 0" lower="-0.5236" upper="2.9671"/>
  <xacro:revolute_joint name="left_hip_yaw_joint" parent="left_hip_roll_link" child="left_hip_yaw_link" xyz="0.025 0 -0.124" rpy="0 0 0" axis="0 0 1" lower="-2.7576" upper="2.7576"/>
  <xacro:revolute_joint name="left_knee_joint" parent="left_hip_yaw_link" child="left_knee_link" xyz="-0.078273 0.0021489 -0.17734" rpy="0 0.17490010 0" axis="0 1 0" lower="-0.087267" upper="2.8798"/>
  <xacro:revolute_joint name="left_ankle_pitch_joint" parent="left_knee_link" child="left_ankle_pitch_link" xyz="0 -9.4445e-05 -0.30001" rpy="0 0 0" axis="0 1 0" lower="-0.87267" upper="0.5236"/>
  <xacro:revolute_joint name="left_ankle_roll_joint" parent="left_ankle_pitch_link" child="left_ankle_roll_link" xyz="0 0 -0.017558" rpy="0 0 0" axis="1 0 0" lower="-0.2618" upper="0.2618"/>

  <xacro:mesh_link name="right_hip_pitch_link" mesh="right_hip_pitch_link"/>
  <xacro:mesh_link name="right_hip_roll_link" mesh="right_hip_roll_link"/>
  <xacro:mesh_link name="right_hip_yaw_link" mesh="right_hip_yaw_link"/>
  <xacro:mesh_link name="right_knee_link" mesh="right_knee_link"/>
  <xacro:mesh_link name="right_ankle_pitch_link" mesh="right_ankle_pitch_link"/>
  <xacro:mesh_link name="right_ankle_roll_link" mesh="right_ankle_roll_link"/>

  <xacro:revolute_joint name="right_hip_pitch_joint" parent="pelvis" child="right_hip_pitch_link" xyz="0 -0.064452 -0.1027" rpy="0 0 0" axis="0 1 0" lower="-2.5307" upper="2.8798"/>
  <xacro:revolute_joint name="right_hip_roll_joint" parent="right_hip_pitch_link" child="right_hip_roll_link" xyz="0 -0.052 -0.030465" rpy="0 -0.17490010 0" axis="1 0 0" lower="-2.9671" upper="0.5236"/>
  <xacro:revolute_joint name="right_hip_yaw_joint" parent="right_hip_roll_link" child="right_hip_yaw_link" xyz="0.025 0 -0.124" rpy="0 0 0" axis="0 0 1" lower="-2.7576" upper="2.7576"/>
  <xacro:revolute_joint name="right_knee_joint" parent="right_hip_yaw_link" child="right_knee_link" xyz="-0.078273 -0.0021489 -0.17734" rpy="0 0.17490010 0" axis="0 1 0" lower="-0.087267" upper="2.8798"/>
  <xacro:revolute_joint name="right_ankle_pitch_joint" parent="right_knee_link" child="right_ankle_pitch_link" xyz="0 9.4445e-05 -0.30001" rpy="0 0 0" axis="0 1 0" lower="-0.87267" upper="0.5236"/>
  <xacro:revolute_joint name="right_ankle_roll_joint" parent="right_ankle_pitch_link" child="right_ankle_roll_link" xyz="0 0 -0.017558" rpy="0 0 0" axis="1 0 0" lower="-0.2618" upper="0.2618"/>

  <xacro:mesh_link name="waist_yaw_link" mesh="waist_yaw_link_rev_1_0"/>
  <xacro:mesh_link name="waist_roll_link" mesh="waist_roll_link_rev_1_0"/>
  <xacro:mesh_link name="torso_link" mesh="torso_link_rev_1_0"/>
  <xacro:mesh_link name="head_link" mesh="head_link"/>

  <xacro:revolute_joint name="waist_yaw_joint" parent="pelvis" child="waist_yaw_link" xyz="0 0 0" rpy="0 0 0" axis="0 0 1" lower="-2.618" upper="2.618"/>
  <xacro:revolute_joint name="waist_roll_joint" parent="waist_yaw_link" child="waist_roll_link" xyz="-0.0039635 0 0.035" rpy="0 0 0" axis="1 0 0" lower="-0.52" upper="0.52"/>
  <xacro:revolute_joint name="waist_pitch_joint" parent="waist_roll_link" child="torso_link" xyz="0 0 0.019" rpy="0 0 0" axis="0 1 0" lower="-0.52" upper="0.52"/>
  <joint name="head_fixed_joint" type="fixed"><parent link="torso_link"/><child link="head_link"/><origin xyz="0.0039635 0 -0.054" rpy="0 0 0"/></joint>

  <xacro:mesh_link name="left_shoulder_pitch_link" mesh="left_shoulder_pitch_link"/>
  <xacro:mesh_link name="left_shoulder_roll_link" mesh="left_shoulder_roll_link"/>
  <xacro:mesh_link name="left_shoulder_yaw_link" mesh="left_shoulder_yaw_link"/>
  <xacro:mesh_link name="left_elbow_link" mesh="left_elbow_link"/>
  <xacro:mesh_link name="left_wrist_roll_link" mesh="left_wrist_roll_link"/>
  <xacro:mesh_link name="left_wrist_pitch_link" mesh="left_wrist_pitch_link"/>
  <xacro:mesh_link name="left_wrist_yaw_link" mesh="left_wrist_yaw_link"/>
  <xacro:mesh_link name="left_rubber_hand" mesh="left_rubber_hand"/>

  <xacro:revolute_joint name="left_shoulder_pitch_joint" parent="torso_link" child="left_shoulder_pitch_link" xyz="0.0039563 0.10022 0.23778" rpy="0.27930898 0.00005495 -0.00019159" axis="0 1 0" lower="-3.0892" upper="2.6704"/>
  <xacro:revolute_joint name="left_shoulder_roll_joint" parent="left_shoulder_pitch_link" child="left_shoulder_roll_link" xyz="0 0.038 -0.013831" rpy="-0.27925040 0 0" axis="1 0 0" lower="-1.5882" upper="2.2515"/>
  <xacro:revolute_joint name="left_shoulder_yaw_joint" parent="left_shoulder_roll_link" child="left_shoulder_yaw_link" xyz="0 0.00624 -0.1032" rpy="0 0 0" axis="0 0 1" lower="-2.618" upper="2.618"/>
  <xacro:revolute_joint name="left_elbow_joint" parent="left_shoulder_yaw_link" child="left_elbow_link" xyz="0.015783 0 -0.080518" rpy="0 0 0" axis="0 1 0" lower="-1.0472" upper="2.0944"/>
  <xacro:revolute_joint name="left_wrist_roll_joint" parent="left_elbow_link" child="left_wrist_roll_link" xyz="0.100 0 -0.010" rpy="0 0 0" axis="1 0 0" lower="-1.97" upper="1.97"/>
  <xacro:revolute_joint name="left_wrist_pitch_joint" parent="left_wrist_roll_link" child="left_wrist_pitch_link" xyz="0.038 0 0" rpy="0 0 0" axis="0 1 0" lower="-1.61" upper="1.61"/>
  <xacro:revolute_joint name="left_wrist_yaw_joint" parent="left_wrist_pitch_link" child="left_wrist_yaw_link" xyz="0.046 0 0" rpy="0 0 0" axis="0 0 1" lower="-1.61" upper="1.61"/>
  <joint name="left_hand_fixed_joint" type="fixed"><parent link="left_wrist_yaw_link"/><child link="left_rubber_hand"/><origin xyz="0.0415 0.003 0" rpy="0 0 0"/></joint>

  <xacro:mesh_link name="right_shoulder_pitch_link" mesh="right_shoulder_pitch_link"/>
  <xacro:mesh_link name="right_shoulder_roll_link" mesh="right_shoulder_roll_link"/>
  <xacro:mesh_link name="right_shoulder_yaw_link" mesh="right_shoulder_yaw_link"/>
  <xacro:mesh_link name="right_elbow_link" mesh="right_elbow_link"/>
  <xacro:mesh_link name="right_wrist_roll_link" mesh="right_wrist_roll_link"/>
  <xacro:mesh_link name="right_wrist_pitch_link" mesh="right_wrist_pitch_link"/>
  <xacro:mesh_link name="right_wrist_yaw_link" mesh="right_wrist_yaw_link"/>
  <xacro:mesh_link name="right_rubber_hand" mesh="right_rubber_hand"/>

  <xacro:revolute_joint name="right_shoulder_pitch_joint" parent="torso_link" child="right_shoulder_pitch_link" xyz="0.0039563 -0.10021 0.23778" rpy="-0.27930898 0.00005495 0.00019159" axis="0 1 0" lower="-3.0892" upper="2.6704"/>
  <xacro:revolute_joint name="right_shoulder_roll_joint" parent="right_shoulder_pitch_link" child="right_shoulder_roll_link" xyz="0 -0.038 -0.013831" rpy="0.27925040 0 0" axis="1 0 0" lower="-2.2515" upper="1.5882"/>
  <xacro:revolute_joint name="right_shoulder_yaw_joint" parent="right_shoulder_roll_link" child="right_shoulder_yaw_link" xyz="0 -0.00624 -0.1032" rpy="0 0 0" axis="0 0 1" lower="-2.618" upper="2.618"/>
  <xacro:revolute_joint name="right_elbow_joint" parent="right_shoulder_yaw_link" child="right_elbow_link" xyz="0.015783 0 -0.080518" rpy="0 0 0" axis="0 1 0" lower="-1.0472" upper="2.0944"/>
  <xacro:revolute_joint name="right_wrist_roll_joint" parent="right_elbow_link" child="right_wrist_roll_link" xyz="0.100 0 -0.010" rpy="0 0 0" axis="1 0 0" lower="-1.97" upper="1.97"/>
  <xacro:revolute_joint name="right_wrist_pitch_joint" parent="right_wrist_roll_link" child="right_wrist_pitch_link" xyz="0.038 0 0" rpy="0 0 0" axis="0 1 0" lower="-1.61" upper="1.61"/>
  <xacro:revolute_joint name="right_wrist_yaw_joint" parent="right_wrist_pitch_link" child="right_wrist_yaw_link" xyz="0.046 0 0" rpy="0 0 0" axis="0 0 1" lower="-1.61" upper="1.61"/>
  <joint name="right_hand_fixed_joint" type="fixed"><parent link="right_wrist_yaw_link"/><child link="right_rubber_hand"/><origin xyz="0.0415 -0.003 0" rpy="0 0 0"/></joint>

  <link name="d435i_color_optical_frame"/>
  <link name="d435i_depth_optical_frame"/>
  <link name="d435i_imu_frame"/>
  <link name="livox_frame"/>
  <joint name="d435i_color_mount" type="fixed"><parent link="head_link"/><child link="d435i_color_optical_frame"/><origin xyz="0.08 0 0.02" rpy="-1.5708 0 -1.5708"/></joint>
  <joint name="d435i_depth_mount" type="fixed"><parent link="d435i_color_optical_frame"/><child link="d435i_depth_optical_frame"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <joint name="d435i_imu_mount" type="fixed"><parent link="d435i_color_optical_frame"/><child link="d435i_imu_frame"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <joint name="livox_mount" type="fixed"><parent link="head_link"/><child link="livox_frame"/><origin xyz="0.10 0 0.08" rpy="3.14159265358979 0 0"/></joint>
</robot>
