diff --git a/simulate/src/goal_overlay.cc b/simulate/src/goal_overlay.cc
new file mode 100644
index 0000000..207932b
--- /dev/null
+++ b/simulate/src/goal_overlay.cc
@@ -0,0 +1,114 @@
+#include "goal_overlay.h"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace unitree_mujoco
+{
+void AppendGoalOverlay(const mjModel * model, const mjData * data,
+  const GoalVisualPacket & packet, mjvScene * scene)
+{
+  if (!model || !data || !scene || !packet.active || !ValidGoalPacket(packet)) {return;}
+  const int root = mj_name2id(model, mjOBJ_BODY, "pelvis");
+  if (root < 0) {return;}
+  const auto * rotation = data->xmat + 9 * root;
+  const double yaw = std::atan2(rotation[3], rotation[0]);
+  const double x = data->xpos[3*root] + std::cos(yaw)*packet.forward - std::sin(yaw)*packet.left;
+  const double y = data->xpos[3*root+1] + std::sin(yaw)*packet.forward + std::cos(yaw)*packet.left;
+  const float color[4] = {0.15f, 1.0f, 0.25f, 1.0f};
+  auto geometry = [&](int type) -> mjvGeom * {
+    if (scene->ngeom >= scene->maxgeom) {return nullptr;}
+    auto * geom = &scene->geoms[scene->ngeom++];
+    mjv_initGeom(geom, type, nullptr, nullptr, nullptr, color);
+    geom->category = mjCAT_DECOR;
+    geom->objtype = mjOBJ_UNKNOWN;
+    geom->objid = -1;
+    geom->segid = -1;
+    geom->emission = .5f;
+    return geom;
+  };
+  constexpr int segments = 32;
+  constexpr double pi = 3.14159265358979323846;
+  for (int i = 0; i < segments; ++i) {
+    const double a = 2*pi*i/segments, b = 2*pi*(i+1)/segments;
+    const mjtNum start[3] = {x+packet.radius*std::cos(a), y+packet.radius*std::sin(a), .035};
+    const mjtNum end[3] = {x+packet.radius*std::cos(b), y+packet.radius*std::sin(b), .035};
+    if (auto * geom = geometry(mjGEOM_CAPSULE)) {mjv_connector(geom, mjGEOM_CAPSULE, .018, start, end);}
+  }
+  const mjtNum top[3] = {x, y, 1.0}, bottom[3] = {x, y, .08};
+  if (auto * geom = geometry(mjGEOM_ARROW)) {mjv_connector(geom, mjGEOM_ARROW, .055, top, bottom);}
+  if (auto * geom = geometry(mjGEOM_SPHERE)) {
+    geom->size[0] = geom->size[1] = geom->size[2] = .07;
+    geom->pos[0] = x; geom->pos[1] = y; geom->pos[2] = 1.08;
+    std::snprintf(geom->label, sizeof(geom->label), "GOAL %.1fm", std::hypot(packet.forward, packet.left));
+  }
+}
+}  // namespace unitree_mujoco
+
+namespace
+{
+class GoalReceiver
+{
+public:
+  GoalReceiver()
+  {
+    const char * enabled = std::getenv("UNITREE_MUJOCO_GOAL_VISUAL_ENABLE");
+    if (!enabled || (std::strcmp(enabled, "true") != 0 && std::strcmp(enabled, "1") != 0)) {return;}
+    const char * path = std::getenv("UNITREE_MUJOCO_GOAL_VISUAL_SOCKET");
+    if (!path) {path = "/tmp/unitree_g1_goal_visual.sock";}
+    if (std::strlen(path) >= sizeof(address_.sun_path)) {return;}
+    address_.sun_family = AF_UNIX;
+    std::strcpy(address_.sun_path, path);
+    socket_ = ::socket(AF_UNIX, SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+    if (socket_ < 0) {return;}
+    ::unlink(path);
+    if (::bind(socket_, reinterpret_cast<sockaddr *>(&address_), sizeof(address_)) != 0) {
+      ::close(socket_); socket_ = -1;
+    }
+  }
+  ~GoalReceiver()
+  {
+    if (socket_ >= 0) {::close(socket_); ::unlink(address_.sun_path);}
+  }
+  void Draw(const mjModel * model, const mjData * data, mjvScene * scene)
+  {
+    if (socket_ < 0) {return;}
+    unsigned char buffer[sizeof(packet_)+1];
+    for (int i = 0; i < 64; ++i) {
+      const auto size = ::recv(socket_, buffer, sizeof(buffer), MSG_DONTWAIT);
+      if (size < 0) {break;}
+      if (size != sizeof(packet_)) {continue;}
+      unitree_mujoco::GoalVisualPacket candidate;
+      std::memcpy(&candidate, buffer, sizeof(candidate));
+      if (unitree_mujoco::ValidGoalPacket(candidate)) {packet_ = candidate;}
+    }
+    const auto now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+    if (unitree_mujoco::GoalIsVisible(packet_, now)) {
+      if (!announced_) {std::puts("MuJoCo goal overlay active (render-only, excluded from sensors and physics)"); announced_ = true;}
+      unitree_mujoco::AppendGoalOverlay(model, data, packet_, scene);
+    }
+  }
+private:
+  int socket_{-1};
+  bool announced_{false};
+  sockaddr_un address_{};
+  unitree_mujoco::GoalVisualPacket packet_{};
+};
+}
+
+// CMake redirects only the viewer's mjv_updateScene calls here. Sensor workers
+// still call the original MuJoCo APIs and never receive decorative geometry.
+extern "C" void unitree_mjv_updateScene(const mjModel * model, mjData * data,
+  const mjvOption * option, const mjvPerturb * perturb, mjvCamera * camera,
+  int category_mask, mjvScene * scene)
+{
+  mjv_updateScene(model, data, option, perturb, camera, category_mask, scene);
+  static GoalReceiver receiver;
+  receiver.Draw(model, data, scene);
+}
diff --git a/simulate/src/goal_overlay.h b/simulate/src/goal_overlay.h
new file mode 100644
index 0000000..3871d18
--- /dev/null
+++ b/simulate/src/goal_overlay.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <mujoco/mujoco.h>
+
+namespace unitree_mujoco
+{
+#pragma pack(push, 1)
+struct GoalVisualPacket
+{
+  uint32_t magic{0x314C4F47};
+  uint32_t active{0};
+  uint64_t stamp_ns{0};
+  float forward{0}, left{0}, radius{0.50f};
+};
+#pragma pack(pop)
+static_assert(sizeof(GoalVisualPacket) == 28, "Goal overlay wire format changed");
+
+inline bool ValidGoalPacket(const GoalVisualPacket & packet)
+{
+  return packet.magic == 0x314C4F47 && packet.active <= 1 &&
+    std::isfinite(packet.forward) && std::isfinite(packet.left) && std::isfinite(packet.radius) &&
+    std::abs(packet.forward) <= 1000 && std::abs(packet.left) <= 1000 &&
+    packet.radius >= .05f && packet.radius <= 3.f;
+}
+
+inline bool GoalIsVisible(const GoalVisualPacket & packet, uint64_t now_ns)
+{
+  return ValidGoalPacket(packet) && packet.active && packet.stamp_ns <= now_ns &&
+    now_ns - packet.stamp_ns <= 750000000;
+}
+
+// Only mjvScene is modified. Nothing is inserted into mjModel or mjData, so
+// raycast sensors and contact physics cannot see or collide with this marker.
+void AppendGoalOverlay(const mjModel * model, const mjData * data,
+  const GoalVisualPacket & packet, mjvScene * scene);
+}  // namespace unitree_mujoco
diff --git a/simulate/src/natural_pedestrian_motion.h b/simulate/src/natural_pedestrian_motion.h
new file mode 100644
index 0000000..b889be3
--- /dev/null
+++ b/simulate/src/natural_pedestrian_motion.h
@@ -0,0 +1,108 @@
+#pragma once
+
+#include "pedestrian_scenarios.h"
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+namespace unitree_mujoco
+{
+struct PedestrianKinematics
+{
+  double x{0}, y{0}, vx{0}, vy{0}, heading{0}, gait_phase{0};
+};
+
+struct PedestrianStyle
+{
+  double speed{0.85}, acceleration{1.0}, turn_rate{1.8}, space{1.15}, stride_length{1.12};
+};
+
+inline PedestrianStyle NaturalPedestrianStyle(int seed, int index)
+{
+  return {.65 + .50*PedestrianSeededRandom01(seed, index, 700),
+    .85 + .35*PedestrianSeededRandom01(seed, index, 701),
+    1.5 + .7*PedestrianSeededRandom01(seed, index, 702),
+    1.05 + .25*PedestrianSeededRandom01(seed, index, 703),
+    1.05 + .20*PedestrianSeededRandom01(seed, index, 704)};
+}
+
+inline double WrappedAngle(double angle) {return std::atan2(std::sin(angle), std::cos(angle));}
+
+// Only other pedestrians enter this interaction model. The robot is deliberately
+// absent: it remains responsible for avoiding the independent crowd.
+inline std::array<double, 2> PedestrianPreferredVelocity(
+  const PedestrianKinematics & self, double target_x, double target_y, double speed,
+  const std::vector<PedestrianKinematics> & neighbors, const PedestrianStyle & style)
+{
+  const double distance = std::hypot(target_x-self.x, target_y-self.y);
+  if (distance < 1e-6 || speed <= 0) {return {0., 0.};}
+  const double ux = (target_x-self.x)/distance, uy = (target_y-self.y)/distance;
+  double vx = speed*ux, vy = speed*uy;
+  for (const auto & other : neighbors) {
+    const double rx = other.x-self.x, ry = other.y-self.y;
+    const double separation = std::hypot(rx, ry);
+    if (separation < 1e-6 || separation > 3.5) {continue;}
+    const double rvx = other.vx-self.vx, rvy = other.vy-self.vy;
+    const double t = std::clamp(-(rx*rvx+ry*rvy)/std::max(1e-6, rvx*rvx+rvy*rvy), 0., 2.);
+    const double closest = std::hypot(rx+rvx*t, ry+rvy*t);
+    const double ahead = rx*ux+ry*uy;
+    if (ahead > 0 && closest < style.space && t > .05) {
+      const double strength = 1.2*(1.-closest/style.space)*(1.-.25*t);
+      vx += strength*uy;  // Passing convention: each walker keeps to their right.
+      vy -= strength*ux;
+    }
+    if (ahead > 0 && ahead < 1.8 && std::abs(rx*uy-ry*ux) < .65 &&
+        other.vx*ux+other.vy*uy > .15) {
+      const double following = std::clamp((ahead-.85)/1.0, 0., 1.);
+      vx *= following; vy *= following;
+    }
+    if (separation < style.space) {
+      const double force = .9*(style.space-separation)/style.space;
+      vx -= force*rx/separation; vy -= force*ry/separation;
+    }
+  }
+  const double magnitude = std::hypot(vx, vy);
+  if (magnitude > speed) {vx *= speed/magnitude; vy *= speed/magnitude;}
+  return {vx, vy};
+}
+
+template <typename Clear>
+void StepNaturalPedestrian(PedestrianKinematics & state, std::array<double, 2> preferred,
+  const PedestrianStyle & style, double dt, Clear clear)
+{
+  if (!(dt > 0.0)) {return;}
+  const double old_speed = std::hypot(state.vx, state.vy);
+  const double desired_speed = std::hypot(preferred[0], preferred[1]);
+  const double wanted_heading = desired_speed > .01 ? std::atan2(preferred[1], preferred[0]) : state.heading;
+  const double turn = WrappedAngle(wanted_heading-state.heading);
+  const double turn_limit = std::min(style.turn_rate, 1.2/std::max(.2, old_speed))*dt;
+  const double heading = state.heading + std::clamp(turn, -turn_limit, turn_limit);
+  // Turn toward a new destination before accelerating, instead of moonwalking.
+  const double target_speed = desired_speed*std::max(0., std::cos(WrappedAngle(wanted_heading-heading)));
+  const double speed = old_speed + std::clamp(target_speed-old_speed,
+    -style.acceleration*dt, style.acceleration*dt);
+  const double nx = state.x + std::cos(heading)*speed*dt;
+  const double ny = state.y + std::sin(heading)*speed*dt;
+  state.heading = WrappedAngle(heading);
+  if (clear(nx, ny)) {
+    state.vx = (nx-state.x)/dt; state.vy = (ny-state.y)/dt;
+    state.x = nx; state.y = ny;
+    state.gait_phase = std::fmod(state.gait_phase + speed*dt/style.stride_length*2.*3.14159265358979323846,
+                                2.*3.14159265358979323846);
+  } else {
+    state.vx = state.vy = 0.;
+  }
+  // Settle into double support as the walker stops. Idle never cycles/bounces.
+  if (std::hypot(state.vx, state.vy) < .3) {
+    const double support = std::round((state.gait_phase-1.5707963267948966)/3.14159265358979323846)*3.14159265358979323846 + 1.5707963267948966;
+    state.gait_phase += std::clamp(support-state.gait_phase, -4.*dt, 4.*dt);
+  }
+}
+
+inline int NaturalWalkFrame(double phase, double speed, int frame_count, int idle_frame = 0)
+{
+  if (frame_count <= 1 || speed < .03) {return idle_frame;}
+  const double wrapped = std::fmod(phase+2.*3.14159265358979323846, 2.*3.14159265358979323846);
+  return static_cast<int>(wrapped/(2.*3.14159265358979323846)*frame_count) % frame_count;
+}
+}  // namespace unitree_mujoco
diff --git a/simulate/src/pedestrian_path_planner.h b/simulate/src/pedestrian_path_planner.h
new file mode 100644
index 0000000..e4db9a9
--- /dev/null
+++ b/simulate/src/pedestrian_path_planner.h
@@ -0,0 +1,83 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <limits>
+#include <queue>
+#include <vector>
+
+namespace unitree_mujoco
+{
+using PedestrianPoint = std::array<double, 2>;
+
+// Static-obstacle-only A*. Deliberately has no robot pose or velocity input.
+template <typename Clear>
+std::vector<PedestrianPoint> PlanPedestrianPath(PedestrianPoint start, PedestrianPoint goal, Clear clear)
+{
+    constexpr double resolution = 0.25;
+    constexpr double min_x = -8.0, min_y = -7.0;
+    constexpr int width = 65, height = 57;
+    auto point = [](int cell) -> PedestrianPoint {
+        return {min_x + (cell % width) * resolution, min_y + (cell / width) * resolution};
+    };
+    auto cell = [](PedestrianPoint p) {
+        const int x = static_cast<int>(std::round((p[0] - min_x) / resolution));
+        const int y = static_cast<int>(std::round((p[1] - min_y) / resolution));
+        return x < 0 || x >= width || y < 0 || y >= height ? -1 : y * width + x;
+    };
+    auto segment_clear = [&](PedestrianPoint a, PedestrianPoint b) {
+        const int steps = std::max(1, static_cast<int>(std::ceil(std::hypot(b[0] - a[0], b[1] - a[1]) / 0.10)));
+        for (int i = 0; i <= steps; ++i)
+        {
+            const double t = static_cast<double>(i) / steps;
+            if (!clear(a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1]))) return false;
+        }
+        return true;
+    };
+    const int first = cell(start), last = cell(goal);
+    if (first < 0 || last < 0 || !segment_clear(start, point(first)) || !segment_clear(point(last), goal)) return {};
+    if (segment_clear(start, goal)) return {start, goal};
+    using Entry = std::pair<double, int>;
+    std::priority_queue<Entry, std::vector<Entry>, std::greater<Entry>> frontier;
+    std::vector<double> cost(width * height, std::numeric_limits<double>::infinity());
+    std::vector<int> previous(width * height, -1);
+    cost[first] = 0.0;
+    frontier.push({0.0, first});
+    while (!frontier.empty())
+    {
+        const int current = frontier.top().second;
+        frontier.pop();
+        if (current == last) break;
+        for (int dy = -1; dy <= 1; ++dy)
+        {
+            for (int dx = -1; dx <= 1; ++dx)
+            {
+                const int x = current % width + dx, y = current / width + dy;
+                if ((!dx && !dy) || x < 0 || x >= width || y < 0 || y >= height) continue;
+                const int next = y * width + x;
+                const double next_cost = cost[current] + std::hypot(dx, dy) * resolution;
+                if (next_cost >= cost[next] || !segment_clear(point(current), point(next))) continue;
+                cost[next] = next_cost;
+                previous[next] = current;
+                const auto p = point(next);
+                frontier.push({next_cost + std::hypot(p[0] - goal[0], p[1] - goal[1]), next});
+            }
+        }
+    }
+    if (previous[last] < 0) return {};
+    std::vector<PedestrianPoint> path{goal};
+    for (int current = last; current != first; current = previous[current]) path.push_back(point(current));
+    path.push_back(start);
+    std::reverse(path.begin(), path.end());
+    std::vector<PedestrianPoint> smoothed{start};
+    for (size_t i = 0; i + 1 < path.size();)
+    {
+        size_t next = path.size() - 1;
+        while (next > i + 1 && !segment_clear(path[i], path[next])) --next;
+        smoothed.push_back(path[next]);
+        i = next;
+    }
+    return smoothed;
+}
+}  // namespace unitree_mujoco
diff --git a/simulate/src/pedestrian_scenarios.h b/simulate/src/pedestrian_scenarios.h
new file mode 100644
index 0000000..334717d
--- /dev/null
+++ b/simulate/src/pedestrian_scenarios.h
@@ -0,0 +1,121 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <cmath>
+#include <algorithm>
+#include <string>
+
+namespace unitree_mujoco
+{
+struct PlazaEnduranceCourse
+{
+    double start_x;
+    double start_y;
+    double end_x;
+    double end_y;
+    double crossing_x;
+    double crossing_y;
+    double trigger_x;
+    double speed;
+};
+
+inline bool IsLabEnduranceScenario(const std::string &scenario)
+{
+    return scenario == "demo_endurance";
+}
+
+inline bool IsPlazaEnduranceScenario(const std::string &scenario)
+{
+    return scenario == "demo_endurance_plaza";
+}
+
+inline double PedestrianSeededRandom01(int seed, int pedestrian_index, int axis)
+{
+    std::uint64_t value = static_cast<std::uint32_t>(seed);
+    value += 0x9e3779b97f4a7c15ULL * static_cast<std::uint64_t>(pedestrian_index + 1);
+    value += 0xbf58476d1ce4e5b9ULL * static_cast<std::uint64_t>(axis + 1);
+    value = (value ^ (value >> 30U)) * 0xbf58476d1ce4e5b9ULL;
+    value = (value ^ (value >> 27U)) * 0x94d049bb133111ebULL;
+    value ^= value >> 31U;
+    return static_cast<double>(value >> 11U) * (1.0 / 9007199254740992.0);
+}
+
+inline PlazaEnduranceCourse MakePlazaEnduranceCourse(int pedestrian_index, int seed)
+{
+    static constexpr std::array<double, 4> kCrossingX = {1.25, 3.00, 4.15, 5.20};
+    static constexpr std::array<double, 4> kCrossingY = {0.00, 0.00, 0.00, -1.50};
+    static constexpr std::array<double, 4> kTriggerX = {0.05, 1.90, 3.15, 3.80};
+    static constexpr std::array<double, 4> kBaseSlope = {0.00, -0.13, 0.00, 0.00};
+    static constexpr std::array<double, 4> kBaseSpeed = {0.80, 0.80, 0.80, 0.55};
+    static constexpr std::array<double, 4> kSpeedJitter = {0.08, 0.08, 0.08, 0.03};
+    static constexpr std::array<double, 4> kStartY = {-2.80, -2.80, -2.80, -3.50};
+    static constexpr std::array<double, 4> kEndY = {3.20, 3.20, 1.20, -1.00};
+    constexpr double kSlopeJitter = 0.01;
+
+    const int index = ((pedestrian_index % 4) + 4) % 4;
+    const double slope = kBaseSlope[index]
+        + (2.0 * PedestrianSeededRandom01(seed, pedestrian_index, 0) - 1.0) * kSlopeJitter;
+    return {
+        kCrossingX[index] + (kStartY[index] - kCrossingY[index]) * slope,
+        kStartY[index],
+        kCrossingX[index] + (kEndY[index] - kCrossingY[index]) * slope,
+        kEndY[index],
+        kCrossingX[index],
+        kCrossingY[index],
+        kTriggerX[index],
+        kBaseSpeed[index]
+            + (2.0 * PedestrianSeededRandom01(seed, pedestrian_index, 1) - 1.0)
+                * kSpeedJitter[index],
+    };
+}
+
+struct PlazaPatrolSample
+{
+    double x;
+    double y;
+    double vx;
+    double vy;
+};
+
+// Independent, repeating crossings through the traversable central plaza.
+// No robot-progress triggers or respawn/teleport shortcuts are used.
+inline PlazaPatrolSample SamplePlazaPatrol(int index, int seed, double time)
+{
+    static constexpr double lanes[4][4] = {
+        {1.25, -3.4, 1.25, 3.4},
+        {5.0, -1.5, -3.4, -1.5},
+        {-1.5, 3.4, -1.5, -3.4},
+        {-3.4, 0.8, 2.5, 0.8},
+    };
+    const int lane = ((index % 4) + 4) % 4;
+    const double dx = lanes[lane][2] - lanes[lane][0];
+    const double dy = lanes[lane][3] - lanes[lane][1];
+    const double length = std::hypot(dx, dy);
+    const double speed = 0.60 + 0.25 * PedestrianSeededRandom01(seed, index, 2);
+    const double travel = length / speed;
+    constexpr double pause = 1.0;
+    const double elapsed = std::max(0.0, time - 2.0 * index);
+    const double phase = std::fmod(elapsed, 2.0 * (travel + pause));
+    double distance = 0.0;
+    double velocity = 0.0;
+    if (time >= 2.0 * index && phase < travel)
+    {
+        distance = speed * phase;
+        velocity = speed;
+    }
+    else if (phase < travel + pause)
+    {
+        distance = length;
+    }
+    else if (phase < 2.0 * travel + pause)
+    {
+        distance = length - speed * (phase - travel - pause);
+        velocity = -speed;
+    }
+    if (time < 2.0 * index) distance = 0.0;
+    return {lanes[lane][0] + dx * distance / length,
+            lanes[lane][1] + dy * distance / length,
+            dx * velocity / length, dy * velocity / length};
+}
+}  // namespace unitree_mujoco
diff --git a/simulate/test/goal_overlay_test.cc b/simulate/test/goal_overlay_test.cc
new file mode 100644
index 0000000..f75a169
