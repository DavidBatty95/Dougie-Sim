@@ -0,0 +1,48 @@
+#include "raycast_model.h"
+#include <cmath>
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <string>
+#include <unistd.h>
+
+void Require(bool value, const char *message) {
+  if (!value) {std::cerr << message << std::endl; std::exit(1);}
+}
+int main() {
+  // Off-axis points on a fronto-parallel plane must retain optical Z=2 m.
+  for (double x : {-1.5, 0., 1.5}) {
+    const double range = std::hypot(x, 2.);
+    const double depth = .001 * unitree_mujoco::OpticalDepthMillimeters(range, 2./range);
+    Require(std::abs(depth-2.) <= .001, "Camera publishes ray range instead of optical depth");
+    Require(std::abs((x/2.)*depth-x) <= .001, "Registered back-projection stretches lateral position");
+  }
+  Require(unitree_mujoco::OpticalDepthMillimeters(-1., 1.) == 0, "Invalid depth was encoded");
+  const auto path="/tmp/unitree-ray-model-"+std::to_string(getpid())+".xml";
+  {
+    std::ofstream xml(path);
+    xml << R"(<mujoco><asset><material name="shared" rgba="1 1 1 1"/></asset>
+    <worldbody><geom name="obstacle" type="sphere" pos="2 0 1" size=".2" material="shared"/>
+    <body name="pelvis" pos="0 0 1"><freejoint/><geom name="robot" type="sphere" size=".4" material="shared"/>
+    <body pos=".55 0 0"><joint type="hinge"/><geom name="arm" type="sphere" size=".1" material="shared"/></body>
+    </body></worldbody></mujoco>)";
+  }
+  char error[1024]{};
+  auto *primary=mj_loadXML(path.c_str(),nullptr,error,sizeof(error)); unlink(path.c_str());
+  Require(primary != nullptr,error);
+  auto *copy=mj_copyModel(nullptr,primary);
+  auto *data=mj_makeData(primary); mj_forward(primary,data);
+  const int root=mj_name2id(primary,mjOBJ_BODY,"pelvis");
+  const int robot=mj_name2id(primary,mjOBJ_GEOM,"robot");
+  const int arm=mj_name2id(primary,mjOBJ_GEOM,"arm");
+  const int obstacle=mj_name2id(primary,mjOBJ_GEOM,"obstacle");
+  unitree_mujoco::ExcludeRobotFromRays(copy,root);
+  Require(primary->geom_matid[robot]>=0 && primary->geom_rgba[4*robot+3]==1., "Primary model was modified");
+  Require(copy->geom_matid[robot]==-1 && copy->geom_rgba[4*arm+3]==0., "Robot descendants remain in rays");
+  Require(copy->geom_matid[obstacle]==primary->geom_matid[obstacle], "Environment material changed");
+  const mjtNum origin[3]={0,0,1}, direction[3]={1,0,0}; int id=-1;
+  const auto distance=mj_ray(copy,data,origin,direction,nullptr,1,-1,&id);
+  Require(id==obstacle && std::abs(distance-1.8)<1e-8, "Environment intersection changed after self exclusion");
+  Require(mj_ray(primary,data,origin,direction,nullptr,1,-1,&id)<1. && id==robot, "Primary ray visibility changed");
+  mj_deleteData(data); mj_deleteModel(copy); mj_deleteModel(primary);
+}
