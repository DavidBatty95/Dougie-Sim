  <disable_collisions link1="left_index_proximal_Link" link2="left_index_distal_Link" reason="Adjacent"/>
  <disable_collisions link1="left_index_distal_Link" link2="left_index_tip_Link" reason="Adjacent"/>
  <disable_collisions link1="left_base_link" link2="left_middle_proximal_Link" reason="Adjacent"/>
  <disable_collisions link1="left_middle_proximal_Link" link2="left_middle_distal_Link" reason="Adjacent"/>
