+def unitree_g1_flat_step_foundation_env_cfg(
+  play: bool = False,
+) -> ManagerBasedRlEnvCfg:
+  """Train bounded, alternating low-speed steps before gait specialization."""
+  cfg = unitree_g1_flat_stand_creep_stop_finetune_env_cfg(play=play)
+  twist_cmd = cfg.commands["twist"]
+  assert isinstance(twist_cmd, StandCreepStopVelocityCommandCfg)
+  twist_cmd.resampling_time_range = (2.5, 4.5)
+  twist_cmd.initial_standing_probability = 0.20
+  twist_cmd.moving_stop_probability = 0.30
+  twist_cmd.standing_hold_probability = 0.15
+  twist_cmd.low_speed_probability = 0.55
+  twist_cmd.moderate_speed_probability = 0.20
+  twist_cmd.lateral_probability = 0.0
+  twist_cmd.arc_probability = 0.0
+  twist_cmd.diagonal_probability = 0.0
+  twist_cmd.reverse_probability = 0.35
+  twist_cmd.low_speed_range = (0.03, 0.12)
+  twist_cmd.moderate_speed_range = (0.12, 0.25)
+  twist_cmd.yaw_speed_min = 0.08
+  twist_cmd.yaw_speed_max = 0.18
+
+  cfg.rewards["track_linear_velocity"].weight = 5.0
+  cfg.rewards["track_linear_velocity"].params["std"] = 0.12
+  cfg.rewards["track_angular_velocity"].weight = 4.0
+  cfg.rewards["track_angular_velocity"].params["std"] = 0.20
+  cfg.rewards["air_time"].weight = 0.0
+  cfg.rewards["step_time"] = RewardTermCfg(
+    func=mdp.feet_step_time,
+    weight=0.30,
+    params={
+      "sensor_name": "feet_ground_contact",
+      "target_time": 0.20,
+      "std": 0.10,
+      "command_name": "twist",
+      "command_threshold": 0.04,
+    },
+  )
+  cfg.rewards["alternating_touchdown"] = RewardTermCfg(
+    func=mdp.alternating_foot_touchdown,
+    weight=0.30,
+    params={
+      "sensor_name": "feet_ground_contact",
+      "command_name": "twist",
+      "command_threshold": 0.04,
+    },
+  )
+  cfg.rewards["foot_clearance"].weight = 0.0
+  cfg.rewards["foot_swing_height"].weight = -0.35
+  cfg.rewards["foot_swing_height"].params["target_height"] = 0.05
+  cfg.rewards["foot_slip"].weight = -0.30
+  cfg.rewards["action_excess_l2"].weight = -5.0
+  cfg.rewards["action_magnitude_l2"].weight = -0.02
+  cfg.rewards["action_rate_l2"].weight = -0.20
+  cfg.rewards["upright"].weight = 2.0
+  return cfg
+
+
