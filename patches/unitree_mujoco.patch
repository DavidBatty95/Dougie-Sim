+++ b/simulate/test/goal_overlay_test.cc
@@ -0,0 +1,59 @@
+#include "goal_overlay.h"
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+void Require(bool condition, const char * message)
+{
+  if (!condition) {std::fprintf(stderr, "%s\n", message); std::exit(1);}
+}
+
+int main()
+{
+  using namespace unitree_mujoco;
+  GoalVisualPacket packet;
+  packet.active = 1;
+  packet.stamp_ns = 1000000000;
+  packet.forward = 2.; packet.left = 1.;
+  Require(GoalIsVisible(packet, 1700000000), "Fresh marker missing");
+  Require(!GoalIsVisible(packet, 1750000001), "Stale marker must expire");
+  Require(!GoalIsVisible(packet, 999999999), "Future packet must not render");
+  const char * xml = "<mujoco><worldbody><geom type='plane' size='10 10 .1'/>"
+    "<body name='pelvis' pos='1 2 1' quat='.7071067811865476 0 0 .7071067811865476'>"
+    "<freejoint/><geom type='sphere' size='.1' mass='1'/></body></worldbody></mujoco>";
+  char error[1024]{};
+  mjSpec * spec = mj_parseXMLString(xml, nullptr, error, sizeof(error));
+  Require(spec != nullptr, error);
+  mjModel * model = mj_compile(spec, nullptr);
+  Require(model != nullptr, "Could not compile overlay fixture");
+  mjData * data = mj_makeData(model);
+  mj_forward(model, data);
+  std::vector<mjtNum> before(data->qpos, data->qpos + model->nq);
+  const int physical_geoms = model->ngeom;
+  const mjtNum ray_start[3]{0., 4., 2.}, ray_direction[3]{0., 0., -1.};
+  const double before_ray = mj_ray(model, data, ray_start, ray_direction, nullptr, 1, -1, nullptr);
+  mjvScene scene;
+  mjv_defaultScene(&scene);
+  mjv_makeScene(model, &scene, 128);
+  AppendGoalOverlay(model, data, packet, &scene);
+  Require(scene.ngeom == 34, "Goal ring, arrow and label were not appended");
+  const auto & label = scene.geoms[scene.ngeom-1];
+  Require(std::abs(label.pos[0]) < 1e-8 && std::abs(label.pos[1]-4.) < 1e-8, "Robot-relative goal has incorrect world projection");
+  Require(model->ngeom == physical_geoms, "Overlay modified collision geometry");
+  Require(std::vector<mjtNum>(data->qpos, data->qpos+model->nq) == before, "Overlay modified robot state");
+  Require(mj_ray(model, data, ray_start, ray_direction, nullptr, 1, -1, nullptr) == before_ray,
+    "Overlay became visible to raycast sensors");
+  scene.ngeom = 0;
+  packet.active = 0;
+  AppendGoalOverlay(model, data, packet, &scene);
+  Require(scene.ngeom == 0, "Cancelled marker was rendered");
+  mjv_freeScene(&scene);
+  mjv_defaultScene(&scene);
+  mjv_makeScene(model, &scene, 1);
+  packet.active = 1;
+  AppendGoalOverlay(model, data, packet, &scene);
+  Require(scene.ngeom == 1, "Overlay overran scene capacity");
+  mjv_freeScene(&scene);
+  mj_deleteData(data); mj_deleteModel(model); mj_deleteSpec(spec);
+}
diff --git a/simulate/test/natural_pedestrians_test.cc b/simulate/test/natural_pedestrians_test.cc
new file mode 100644
index 0000000..03876af
--- /dev/null
+++ b/simulate/test/natural_pedestrians_test.cc
@@ -0,0 +1,83 @@
+#include "natural_pedestrian_motion.h"
+#include <mujoco/mujoco.h>
+#include <cstdlib>
+#include <iostream>
+#include <filesystem>
+
+void Require(bool value, const char * text)
+{
+  if (!value) {std::cerr << text << std::endl; std::exit(1);}
+}
+
+int main()
+{
+  using namespace unitree_mujoco;
+  const auto style = NaturalPedestrianStyle(43, 2);
+  Require(style.speed == NaturalPedestrianStyle(43, 2).speed, "Styles must be seeded");
+  Require(style.speed != NaturalPedestrianStyle(44, 2).speed, "Seeds must change styles");
+  PedestrianKinematics idle;
+  for (int i = 0; i < 1000; ++i) {
+    StepNaturalPedestrian(idle, {0., 0.}, style, .01, [](double, double) {return true;});
+    Require(idle.x == 0. && idle.y == 0. && NaturalWalkFrame(idle.gait_phase, 0., 16, 16) == 16,
+      "Idle actors must stay still in the neutral pose");
+  }
+  PedestrianKinematics walker;
+  for (int i = 0; i < 300; ++i) {
+    const auto before = walker;
+    StepNaturalPedestrian(walker, {.8, .3}, style, .01, [](double x, double) {return x < .8;});
+    Require(std::hypot(walker.x-before.x, walker.y-before.y) <= .0086, "Position discontinuity");
+    Require(std::abs(WrappedAngle(walker.heading-before.heading)) <= style.turn_rate*.01+1e-9, "Instant heading change");
+    Require(walker.x < .8, "Walker entered static geometry");
+  }
+  PedestrianKinematics a, b;
+  a.x = -3.; b.x = 3.; b.heading = 3.14159265358979323846;
+  PedestrianStyle passing;
+  passing.speed = 1.;
+  double minimum = 10.;
+  for (int i = 0; i < 800; ++i) {
+    const auto old_a = a, old_b = b;
+    auto va = PedestrianPreferredVelocity(old_a, 3., 0., 1., {old_b}, passing);
+    auto vb = PedestrianPreferredVelocity(old_b, -3., 0., 1., {old_a}, passing);
+    StepNaturalPedestrian(a, va, passing, .01, [](double, double) {return true;});
+    StepNaturalPedestrian(b, vb, passing, .01, [](double, double) {return true;});
+    minimum = std::min(minimum, std::hypot(a.x-b.x, a.y-b.y));
+  }
+  if (!(minimum > .84 && a.x > 1. && b.x < -1.)) {
+    std::cerr << "passing clearance=" << minimum << " positions " << a.x << "," << a.y << " / " << b.x << "," << b.y << std::endl;
+  }
+  Require(minimum > .84 && a.x > 1. && b.x < -1., "Opposing walkers must pass rather than overlap or freeze");
+
+  char error[2048]{};
+  mjModel * model = mj_loadXML(NATURAL_SCENE_PATH, nullptr, error, sizeof(error));
+  Require(model != nullptr, error);
+  for (int person = 1; person <= 8; ++person) {
+    const std::string prefix = "ped" + std::to_string(person);
+    Require(mj_name2id(model, mjOBJ_BODY, (prefix+"_torso").c_str()) >= 0, "Missing collision body");
+    for (int frame = 0; frame <= 16; ++frame) {
+      const std::string name = prefix + "_visual_" + (frame < 10 ? "0" : "") + std::to_string(frame);
+      const int body = mj_name2id(model, mjOBJ_BODY, name.c_str());
+      Require(body >= 0 && model->body_mocapid[body] >= 0, "Missing data-driven animation frame");
+    }
+  }
+  mjModel * copy = mj_copyModel(nullptr, model);
+  mjData * data = mj_makeData(model);
+  mjData * snapshot = mj_makeData(copy);
+  const int body = mj_name2id(model, mjOBJ_BODY, "ped1_visual_04");
+  const int mocap = model->body_mocapid[body];
+  data->mocap_pos[3*mocap] = 2.; data->mocap_pos[3*mocap+2] = .99;
+  mj_forward(model, data);
+  mj_copyData(snapshot, copy, data);
+  Require(snapshot->xpos[3*body] == data->xpos[3*body] && snapshot->xpos[3*body+2] == .99,
+    "Sensor snapshots must contain the animated body pose without model mutation");
+  mj_deleteData(snapshot); mj_deleteData(data); mj_deleteModel(copy); mj_deleteModel(model);
+  const auto directory = std::filesystem::path(NATURAL_SCENE_PATH).parent_path();
+  for (const auto *world : {"small_open", "small_clutter", "medium_open", "medium_doorway", "large_pillars", "large_office"}) {
+    const auto path = directory / (std::string("scene_29dof_avoidance_")+world+".xml");
+    auto *scene = mj_loadXML(path.c_str(), nullptr, error, sizeof(error));
+    Require(scene != nullptr, error);
+    Require(mj_name2id(scene, mjOBJ_NUMERIC, "avoidance_world_half_extents") >= 0, "World lacks bounded actor domain");
+    Require(mj_name2id(scene, mjOBJ_BODY, "ped8_visual_16") >= 0, "World lacks natural crowd assets");
+    Require(mj_name2id(scene, mjOBJ_TEXTURE, "world_sign") >= 0, "World lacks representative signage");
+    mj_deleteModel(scene);
+  }
+}
diff --git a/simulate/test/pedestrian_scenarios_test.cc b/simulate/test/pedestrian_scenarios_test.cc
new file mode 100644
index 0000000..e4394c5
--- /dev/null
+++ b/simulate/test/pedestrian_scenarios_test.cc
@@ -0,0 +1,141 @@
+#include "pedestrian_scenarios.h"
+#include "pedestrian_path_planner.h"
+
+#include <array>
+#include <cmath>
+#include <cstdlib>
+#include <iostream>
+
+namespace
+{
+void Check(bool condition, int line)
+{
+    if (!condition)
+    {
+        std::cerr << "pedestrian scenario check failed at line " << line << std::endl;
+        std::abort();
+    }
+}
+#define CHECK(condition) Check((condition), __LINE__)
+
+struct BoxObstacle
+{
+    double x;
+    double y;
+    double half_x;
+    double half_y;
+};
+
+struct CircleObstacle
+{
+    double x;
+    double y;
+    double radius;
+};
+
+bool IsPlazaPointClear(double x, double y)
+{
+    constexpr double kPedestrianRadius = 0.42;
+    constexpr std::array<BoxObstacle, 21> kBoxes = {{
+        {9.3, 0.0, 0.55, 6.9}, {-2.2, 9.65, 5.4, 0.55}, {-1.6, -9.65, 5.0, 0.55},
+        {-11.5, 3.6, 0.75, 2.7}, {-11.5, -3.6, 0.75, 2.7}, {13.0, 3.6, 0.75, 2.65},
+        {13.0, -3.6, 0.75, 2.65}, {-8.2, 11.2, 2.2, 0.7}, {6.8, 11.2, 2.6, 0.7},
+        {-7.8, -11.2, 2.4, 0.7}, {7.0, -11.2, 2.4, 0.7}, {-5.7, 4.7, 1.25, 0.42},
+        {5.7, -4.8, 1.25, 0.42}, {-6.0, -4.9, 1.05, 0.38}, {-2.4, 4.8, 1.0, 0.32},
+        {2.0, -5.0, 1.0, 0.32}, {5.9, 0.6, 0.32, 1.0}, {-5.0, -1.2, 0.8, 0.95},
+        {8.6, -7.2, 0.28, 1.05}, {-6.9, 5.8, 0.18, 0.18}, {6.9, -5.8, 0.18, 0.18},
+    }};
+    constexpr std::array<CircleObstacle, 6> kCircles = {{
+        {4.1, 2.7, 0.95}, {-5.4, -3.6, 0.25}, {5.0, 3.5, 0.28},
+        {-6.4, 2.5, 0.24}, {-3.2, 5.8, 0.12}, {3.0, -5.9, 0.12},
+    }};
+    for (const auto &box : kBoxes)
+    {
+        if (std::abs(x - box.x) <= box.half_x + kPedestrianRadius &&
+            std::abs(y - box.y) <= box.half_y + kPedestrianRadius)
+        {
+            return false;
+        }
+    }
+    for (const auto &circle : kCircles)
+    {
+        if (std::hypot(x - circle.x, y - circle.y) <= circle.radius + kPedestrianRadius)
+        {
+            return false;
+        }
+    }
+    return true;
+}
+}  // namespace
+
+int main()
+{
+    using unitree_mujoco::MakePlazaEnduranceCourse;
+    CHECK(unitree_mujoco::IsLabEnduranceScenario("demo_endurance"));
+    CHECK(!unitree_mujoco::IsLabEnduranceScenario("demo_endurance_plaza"));
+    CHECK(unitree_mujoco::IsPlazaEnduranceScenario("demo_endurance_plaza"));
+
+    double previous_trigger = -1.0;
+    double previous_crossing = -1.0;
+    for (int index = 0; index < 4; ++index)
+    {
+        const auto course = MakePlazaEnduranceCourse(index, 42);
+        const auto repeated = MakePlazaEnduranceCourse(index, 42);
+        const auto different_seed = MakePlazaEnduranceCourse(index, 43);
+        CHECK(course.start_x == repeated.start_x && course.end_x == repeated.end_x);
+        CHECK(course.start_x != different_seed.start_x || course.speed != different_seed.speed);
+        CHECK(course.trigger_x > previous_trigger && course.trigger_x < course.crossing_x);
+        CHECK(course.crossing_x - previous_crossing > 0.70);
+        CHECK(course.speed >= 0.52 && course.speed <= 1.08);
+        CHECK(std::abs(course.start_y - course.crossing_y) > 1.6);
+        CHECK(std::abs(course.end_y - course.crossing_y) > (index < 2 ? 1.6 : 0.4));
+
+        const double crossing_t =
+            (course.crossing_y - course.start_y) / (course.end_y - course.start_y);
+        const double crossing_x = course.start_x + crossing_t * (course.end_x - course.start_x);
+        CHECK(std::abs(crossing_x - course.crossing_x) < 1e-12);
+        for (int sample = 0; sample <= 100; ++sample)
+        {
+            const double t = sample / 100.0;
+            const double x = course.start_x + t * (course.end_x - course.start_x);
+            const double y = course.start_y + t * (course.end_y - course.start_y);
+            if (!IsPlazaPointClear(x, y))
+            {
+                std::cerr << "course " << index << " blocked at (" << x << ", " << y << ")" << std::endl;
+            }
+            CHECK(IsPlazaPointClear(x, y));
+        }
+        previous_trigger = course.trigger_x;
+        previous_crossing = course.crossing_x;
+    }
+    for (int seed : {1, 42, 43})
+    {
+        for (int index = 0; index < 4; ++index)
+        {
+            auto previous = unitree_mujoco::SamplePlazaPatrol(index, seed, -1.0);
+            CHECK(std::hypot(previous.vx, previous.vy) == 0.0);
+            for (int step = 0; step < 12000; ++step)
+            {
+                const auto sample = unitree_mujoco::SamplePlazaPatrol(index, seed, step * 0.01);
+                CHECK(IsPlazaPointClear(sample.x, sample.y));
+                CHECK(std::hypot(sample.x - previous.x, sample.y - previous.y) <= 0.0086);
+                CHECK(std::hypot(sample.vx, sample.vy) <= 0.85);
+                previous = sample;
+            }
+        }
+    }
+    const auto detour = unitree_mujoco::PlanPedestrianPath(
+        {2.0, 2.7}, {6.0, 2.7}, [](double x, double y) { return IsPlazaPointClear(x, y); });
+    CHECK(detour.size() > 2);
+    for (size_t i = 1; i < detour.size(); ++i)
+    {
+        for (int step = 0; step <= 100; ++step)
+        {
+            const double t = step / 100.0;
+            CHECK(IsPlazaPointClear(detour[i - 1][0] + t * (detour[i][0] - detour[i - 1][0]),
+                                    detour[i - 1][1] + t * (detour[i][1] - detour[i - 1][1])));
+        }
+    }
+    CHECK(unitree_mujoco::PlanPedestrianPath({0.0, 0.0}, {1.0, 0.0}, [](double, double) { return false; }).empty());
+    return 0;
+}
diff --git a/simulate/src/pedestrian_start_gate.h b/simulate/src/pedestrian_start_gate.h
new file mode 100644
index 0000000..e2ae90f
--- /dev/null
+++ b/simulate/src/pedestrian_start_gate.h
@@ -0,0 +1,69 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace unitree_mujoco {
+// Episode-start barrier only. Once released, robot state/goals cannot pause,
+// reset or otherwise influence pedestrian behavior.
+class PedestrianStartGate {
+public:
+  static constexpr std::uint32_t request_magic = 0x31535047;
+  static constexpr std::uint32_t ack_magic = 0x31415347;
+  PedestrianStartGate() = default;
+  PedestrianStartGate(const PedestrianStartGate &) = delete;
+  PedestrianStartGate &operator=(const PedestrianStartGate &) = delete;
+  ~PedestrianStartGate() {Close();}
+
+  void Reset(bool enabled, const std::string &path) {
+    Close(); enabled_ = enabled; started_ = !enabled; start_time_ = 0.;
+    if (!enabled) {return;}
+    sockaddr_un address{};
+    if (path.size() >= sizeof(address.sun_path)) {throw std::runtime_error("Pedestrian start socket path too long");}
+    path_ = path;
+    fd_ = socket(AF_UNIX, SOCK_DGRAM | SOCK_NONBLOCK, 0);
+    if (fd_ < 0) {throw std::runtime_error("Cannot create pedestrian start socket");}
+    address.sun_family = AF_UNIX;
+    std::strncpy(address.sun_path, path.c_str(), sizeof(address.sun_path)-1);
+    unlink(path.c_str());
+    if (bind(fd_, reinterpret_cast<sockaddr *>(&address), sizeof(address)) != 0) {
+      Close(); throw std::runtime_error("Cannot bind pedestrian start socket");
+    }
+  }
+
+  void Update(double simulation_time) {
+    if (fd_ < 0) {return;}
+    for (int attempt=0; attempt<16; ++attempt) {
+      std::uint32_t request[3]{};
+      sockaddr_un peer{}; socklen_t length=sizeof(peer);
+      const auto received=recvfrom(fd_, request, sizeof(request), MSG_DONTWAIT,
+        reinterpret_cast<sockaddr *>(&peer), &length);
+      if (received < 0) {break;}
+      if (received != 8 || request[0] != request_magic || request[1] != 1) {continue;}
+      if (!started_) {started_=true; start_time_=simulation_time;}
+      const std::uint32_t reply[2]={ack_magic, 1};
+      sendto(fd_, reply, sizeof(reply), MSG_DONTWAIT, reinterpret_cast<sockaddr *>(&peer), length);
+    }
+  }
+  bool Started() const {return started_;}
+  double Elapsed(double simulation_time) const {
+    return enabled_ ? (started_ ? std::max(0., simulation_time-start_time_) : 0.) : simulation_time;
+  }
+
+private:
+  void Close() {
+    if (fd_ >= 0) {close(fd_); fd_=-1;}
+    if (!path_.empty()) {unlink(path_.c_str()); path_.clear();}
+  }
+  int fd_=-1;
+  bool enabled_=false, started_=true;
+  double start_time_=0.;
+  std::string path_;
+};
+}
diff --git a/simulate/test/pedestrian_start_gate_test.cc b/simulate/test/pedestrian_start_gate_test.cc
new file mode 100644
index 0000000..c0b98d2
--- /dev/null
+++ b/simulate/test/pedestrian_start_gate_test.cc
@@ -0,0 +1,40 @@
+#include "pedestrian_start_gate.h"
+#include <cstddef>
+#include <iostream>
+
+void Require(bool condition, const char *message) {
+  if (!condition) {std::cerr << message << std::endl; std::exit(1);}
+}
+
+int main() {
+  using Gate = unitree_mujoco::PedestrianStartGate;
+  Gate gate;
+  const auto path = "/tmp/unitree-pedestrian-gate-test-" + std::to_string(getpid()) + ".sock";
+  gate.Reset(true, path);
+  gate.Update(10.);
+  Require(!gate.Started() && gate.Elapsed(10.) == 0., "Crowd moved before start acknowledgement");
+  const int client = socket(AF_UNIX, SOCK_DGRAM | SOCK_NONBLOCK, 0);
+  sockaddr_un local{}; local.sun_family=AF_UNIX;
+  const auto name = "unitree-gate-client-" + std::to_string(getpid());
+  std::memcpy(local.sun_path+1, name.data(), name.size());
+  Require(bind(client, reinterpret_cast<sockaddr *>(&local), offsetof(sockaddr_un,sun_path)+1+name.size()) == 0, "Client bind failed");
+  sockaddr_un target{}; target.sun_family=AF_UNIX;
+  std::strncpy(target.sun_path,path.c_str(),sizeof(target.sun_path)-1);
+  auto send = [&](std::uint32_t magic) {
+    const std::uint32_t packet[2]={magic,1};
+    Require(sendto(client,packet,sizeof(packet),0,reinterpret_cast<sockaddr *>(&target),sizeof(target))==8, "Send failed");
+  };
+  send(0); gate.Update(11.);
+  Require(!gate.Started(), "Malformed request started crowd");
+  send(Gate::request_magic); gate.Update(12.);
+  Require(gate.Started() && gate.Elapsed(14.)==2., "Scenario clock did not start at release");
+  std::uint32_t reply[2]{};
+  Require(recv(client,reply,sizeof(reply),0)==8 && reply[0]==Gate::ack_magic, "Missing acknowledgement");
+  send(Gate::request_magic); gate.Update(20.);
+  Require(gate.Elapsed(20.)==8., "Repeated goal reset pedestrian motion");
+  gate.Reset(true,path);
+  Require(!gate.Started() && gate.Elapsed(30.)==0., "New episode retained old start");
+  gate.Reset(false,path);
+  Require(gate.Started() && gate.Elapsed(30.)==30., "Ungated scenarios changed");
+  close(client);
+}
diff --git a/simulate/src/raycast_model.h b/simulate/src/raycast_model.h
new file mode 100644
index 0000000..57bdd04
--- /dev/null
+++ b/simulate/src/raycast_model.h
@@ -0,0 +1,28 @@
+#pragma once
+#include <mujoco/mujoco.h>
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace unitree_mujoco {
+inline std::uint16_t OpticalDepthMillimeters(double range, double ray_z) {
+  const double z = range * ray_z;
+  if (!std::isfinite(z) || range < 0. || z <= 0.) {return 0;}
+  return static_cast<std::uint16_t>(std::min(65535., z * 1000.));
+}
+// Apply only to a sensor's private model copy. This implements the existing
+// robot-exclusion policy before batched ray traversal, instead of repeatedly
+// intersecting and stepping through robot meshes for each self hit.
+inline void ExcludeRobotFromRays(mjModel *model, int root_body) {
+  if (!model || root_body < 1) {return;}
+  for (int geom=0; geom<model->ngeom; ++geom) {
+    int body=model->geom_bodyid[geom];
+    while (body > 0 && body != root_body) {body=model->body_parentid[body];}
+    if (body == root_body) {
+      // MuJoCo ray visibility uses material alpha when a material is assigned.
+      model->geom_matid[geom]=-1;
+      model->geom_rgba[4*geom+3]=0.;
+    }
+  }
+}
+}
